#!/usr/bin/env bash
# wt: worktree + herdr agent 流程。
#   wt new   <name> [base]                      建 worktree 并在 herdr 侧边栏打开
#   wt spawn <name> <role> <kind> <task> [-- agent 参数...]
#                                               在该 worktree 里起 agent 做事，校验产物
#   wt ls                                       列出 agent
#   wt rm    <name> [--yes]                     删 worktree（不带 --yes 只预览）
set -euo pipefail
[ "${HERDR_ENV:-}" = 1 ] || { echo "wt: 需要在 herdr 里运行" >&2; exit 2; }

ROOT="${WT_ROOT:-$HOME/worktrees}"
repo_root() { dirname "$(git rev-parse --path-format=absolute --git-common-dir)"; }
wt_path()   { echo "$ROOT/$(basename "$(repo_root)")/$1"; }

open_ws() { # 幂等：返回 "workspace_id root_pane_id"
  herdr worktree open --cwd "$(repo_root)" --path "$(wt_path "$1")" --label "$1" --no-focus \
    | jq -r '.result | "\(.workspace.workspace_id) \(.root_pane.pane_id)"'
}

cmd_new() {
  local name=$1 base=${2:-$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || git rev-parse --abbrev-ref HEAD)}
  local p; p=$(wt_path "$name")
  if [ ! -d "$p" ]; then
    mkdir -p "$(dirname "$p")"
    git worktree add -b "$name" "$p" "$base" >&2
    [ -x "$p/.wt/setup" ] && (cd "$p" && ./.wt/setup >&2)
  fi
  open_ws "$name" >/dev/null
  echo "$p"
}

free_pane() { # workspace 里没有 agent 的 pane；没有就 split
  local ws=$1 root=$2 p
  p=$(herdr pane list --workspace "$ws" | jq -r '[.result.panes[] | select(.agent == null)][0].pane_id // empty')
  [ -n "$p" ] && { echo "$p"; return; }
  herdr pane split "$root" --direction right --cwd "$(wt_path "$NAME")" --no-focus | jq -r '.result.pane.pane_id'
}

cmd_spawn() {
  NAME=$1; local role=$2 kind=$3 task=$4; shift 4
  [ "${1:-}" = "--" ] && shift
  cmd_new "$NAME" >/dev/null
  local ws root pane agent out
  read -r ws root < <(open_ws "$NAME")
  agent="$NAME-$role"; out="$(wt_path "$NAME")/.agent/$role.md"
  if pane=$(herdr agent get "$agent" 2>/dev/null | jq -er .result.agent.pane_id); then :  # 已在线，复用
  else
    pane=$(free_pane "$ws" "$root")
    herdr agent start "$agent" --kind "$kind" --pane "$pane" ${1:+-- "$@"} >/dev/null
  fi
  local prompt="$task

完成后把结果写入 .agent/$role.md，第一行必须是 'STATUS: ok' 或 'STATUS: fail <原因>'，其后写详细内容。"
  rm -f "$out"
  for try in 1 2; do
    herdr agent prompt "$agent" "$prompt" --wait --timeout "${WT_TIMEOUT:-600000}" >/dev/null 2>&1 || true
    if [ -f "$out" ] && head -1 "$out" | grep -q '^STATUS: ok'; then
      echo "ok $out"; return 0
    fi
    [ "$try" = 1 ] && prompt="上一次没有产出合格的 .agent/$role.md。请重做，并务必写该文件。"
  done
  echo "fail agent=$agent pane=$pane (最后输出如下)" >&2
  herdr pane read "$pane" --source visible 2>&1 | grep -v '^\s*$' | tail -15 >&2
  return 1
}

cmd_ls() { herdr agent list | jq -r '.result.agents[] | "\(.name // "-")\t\(.agent)\t\(.agent_status)\t\(.pane_id)\t\(.cwd)"'; }

cmd_rm() {
  local name=$1 p; p=$(wt_path "$name")
  if [ "${2:-}" != "--yes" ]; then
    echo "将删除: $p (分支 $name 保留)"; git -C "$p" status --short; echo "加 --yes 执行"; return
  fi
  local ws; ws=$(herdr workspace list | jq -r --arg p "$p" '.result.workspaces[] | select(.worktree.checkout_path == $p) | .workspace_id')
  [ -n "$ws" ] && herdr worktree remove --workspace "$ws" >/dev/null
  [ -d "$p" ] && git worktree remove "$p"
  echo "removed $p"
}

c=${1:-}; shift || true
case "$c" in
  new) cmd_new "$@";; spawn) cmd_spawn "$@";; ls) cmd_ls;; rm) cmd_rm "$@";;
  *) sed -n '2,7p' "$0"; exit 1;;
esac
